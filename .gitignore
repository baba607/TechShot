# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtualenvs
venv/
.venv/

# Secrets — NEVER commit
.env
*.env

# Generated media (large; rebuilt per reel). Scripts (.md) and item.json
# in content/ ARE committed — videos/audio/images are not.
*.mp4
*.wav
*.webm
*.webp
*.png
*.jpg
*.jpeg
*.onnx
*.onnx.json

# ...except per-reel SCENE images: the CI build needs them, and they are
# made by Muse (not rebuildable in CI), so they MUST be committed.
!content/**/scene_*.webp
!content/**/scene_*.png
!content/**/scene_*.jpg
!content/**/scene_*.jpeg

# Per-reel build scratch
work/
build/
frames/
segments.txt
subs.ass
